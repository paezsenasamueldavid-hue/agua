{"entries":[{"timestamp":1792507245131,"editorVersion":"9.0.12","changes":[{"type":"edited","filename":"main.blocks","patch":[{"start1":0,"length1":84,"diffs":[[1,"<xml xmlns=\"http://www.w3.org/1999/xhtml\">\n  <block type=\"pxt-on-start\"></block>\n  <block type=\"device_forever\"></block>\n</xml>"]]}]},{"type":"edited","filename":"pxt.json","patch":[{"start1":200,"length1":39,"diffs":[[1,"        \"README.md\"\n"]]},{"start1":227,"length1":31,"diffs":[[1,"    \"additionalFilePaths\": []\n"]]}]},{"type":"added","filename":"main.py","value":"import tkinter as tk\nfrom tkinter import ttk, messagebox\n\n# Configuración inicial\nmeta_diaria = 8\nvasos_tomados = 0\nintervalo_minutos = 60\n\n\ndef registrar_vaso(event=None):\n    global vasos_tomados\n\n    if vasos_tomados < meta_diaria:\n        vasos_tomados += 1\n\n    actualizar_pantalla()\n\n\ndef actualizar_pantalla():\n    progreso = min(vasos_tomados / meta_diaria * 100, 100)\n\n    etiqueta_vasos.config(\n        text=f\"Vasos tomados: {vasos_tomados}/{meta_diaria}\"\n    )\n    barra_progreso[\"value\"] = progreso\n    etiqueta_porcentaje.config(text=f\"Progreso: {progreso:.0f}%\")\n\n    if vasos_tomados >= meta_diaria:\n        etiqueta_estado.config(text=\"¡Meta diaria alcanzada! 🎉\")\n    else:\n        etiqueta_estado.config(text=\"¡Sigue hidratándote! 💧\")\n\n\ndef recordar_agua():\n    if vasos_tomados < meta_diaria:\n        messagebox.showinfo(\n            \"Recordatorio de agua 💧\",\n            \"¡Es hora de beber un vaso de agua!\"\n        )\n\n    ventana.after(intervalo_minutos * 60 * 1000, recordar_agua)\n\n\n# Crear ventana principal\nventana = tk.Tk()\nventana.title(\"Recordatorio de Agua\")\nventana.geometry(\"360x330\")\nventana.resizable(False, False)\nventana.configure(bg=\"#EAF8FF\")\n\n# Título\ntitulo = tk.Label(\n    ventana,\n    text=\"💧 ¡Hora de hidratarte!\",\n    font=(\"Arial\", 18, \"bold\"),\n    bg=\"#EAF8FF\",\n    fg=\"#087EBC\"\n)\ntitulo.pack(pady=15)\n\n# Meta diaria\netiqueta_meta = tk.Label(\n    ventana,\n    text=f\"Meta diaria: {meta_diaria} vasos\",\n    font=(\"Arial\", 12),\n    bg=\"#EAF8FF\"\n)\netiqueta_meta.pack(pady=5)\n\n# Cantidad de vasos\netiqueta_vasos = tk.Label(\n    ventana,\n    text=f\"Vasos tomados: 0/{meta_diaria}\",\n    font=(\"Arial\", 14, \"bold\"),\n    bg=\"#EAF8FF\"\n)\netiqueta_vasos.pack(pady=10)\n\n# Barra de progreso\nbarra_progreso = ttk.Progressbar(\n    ventana,\n    length=280,\n    mode=\"determinate\",\n    maximum=100\n)\nbarra_progreso.pack(pady=5)\n\netiqueta_porcentaje = tk.Label(\n    ventana,\n    text=\"Progreso: 0%\",\n    font=(\"Arial\", 11),\n    bg=\"#EAF8FF\"\n)\netiqueta_porcentaje.pack(pady=5)\n\n# Estado\netiqueta_estado = tk.Label(\n    ventana,\n    text=\"¡Empieza a tomar agua!\",\n    font=(\"Arial\", 11),\n    bg=\"#EAF8FF\",\n    fg=\"#087EBC\"\n)\netiqueta_estado.pack(pady=5)\n\n# Botón B\nboton_b = tk.Button(\n    ventana,\n    text=\"B - Registrar vaso 🥤\",\n    font=(\"Arial\", 12, \"bold\"),\n    bg=\"#20A4F3\",\n    fg=\"white\",\n    activebackground=\"#087EBC\",\n    command=registrar_vaso,\n    width=22\n)\nboton_b.pack(pady=12)\n\n# También permite registrar un vaso pulsando la tecla B\nventana.bind(\"<KeyPress-b>\", registrar_vaso)\nventana.bind(\"<KeyPress-B>\", registrar_vaso)\n\n# Iniciar recordatorios periódicos\nventana.after(intervalo_minutos * 60 * 1000, recordar_agua)\n\n# Ejecutar aplicación\nventana.mainloop()\n\n"}]},{"timestamp":1792507937499,"editorVersion":"9.0.12","changes":[{"type":"edited","filename":"pxt.json","patch":[{"start1":246,"length1":44,"diffs":[[1,""]]}]},{"type":"added","filename":"test.ts","value":"// tests go here; this will not be compiled when this package is used as an extension.\n"}]}],"snapshots":[{"timestamp":1792507245130,"editorVersion":"9.0.12","text":{"main.blocks":"<xml xmlns=\"http://www.w3.org/1999/xhtml\">\n  <block type=\"pxt-on-start\"></block>\n  <block type=\"device_forever\"></block>\n</xml>","main.ts":"\n"